{
  "name": "@openedx/frontend-plugin-universal",
  "version": "1.0.0",
  "description": "Universal frontend plugin for Open edX Micro-Frontends (MFEs)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "browserslist": [
    "extends @edx/browserslist-config"
  ],
  "scripts": {
    "build": "fedx-scripts babel -x .js,.jsx,.ts,.tsx src --out-dir dist --ignore **/*.test.jsx,**/*.test.js && cp src/*.css dist/ 2>/dev/null || true",
    "lint": "fedx-scripts eslint --ext .js --ext .jsx --ext .ts --ext .tsx .",
    "lint:fix": "fedx-scripts eslint --fix --ext .js --ext .jsx --ext .ts --ext .tsx .",
    "test": "fedx-scripts jest --coverage --passWithNoTests src"
  },
  "author": "OpenedX",
  "license": "AGPL-3.0",
  "peerDependencies": {
    "@edx/frontend-platform": "^8.3.1",
    "@openedx/frontend-plugin-framework": "^1.7.0",
    "@openedx/paragon": "^23.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "peerDependenciesMeta": {
    "@edx/frontend-platform": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@edx/browserslist-config": "^1.1.1",
    "@edx/eslint-config": "^4.3.0",
    "@edx/typescript-config": "^1.1.0",
    "@openedx/frontend-build": "14.6.16",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.0",
    "eslint": "^8.57.1",
    "jest": "30.3.0",
    "ts-jest": "^29.4.0",
    "typescript": "^4.9.5"
  }
}

